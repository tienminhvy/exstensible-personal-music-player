# Personal music player environment contract. Copy to .env and fill real values.
# .env is gitignored; never commit real values (workspace AGENTS.md rule).

# YouTube Data API v3 key consumed by the search route. Env-provided only.
YOUTUBE_API_KEY=

# Prisma connection string for the Postgres container.
DATABASE_URL=

# Directory where downloaded audio files are stored (compose bind mount).
MEDIA_DIR=

# Node adapter binding (@sveltejs/adapter-node defaults).
HOST=
PORT=

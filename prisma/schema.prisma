// Prisma schema for the personal music player library.
// Audio-only in this slice: one mediaPath per Track.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Track {
  id          String   @id @default(cuid())
  title       String
  // Unique so re-importing a known clip updates its row instead of
  // duplicating it.
  youtubeId   String   @unique
  // Stored RELATIVE to the media dir (<youtubeId>.mp3). Absolute paths
  // couple the DB to one container's filesystem layout and previously
  // caused the library-loss incident; keep this relative.
  mediaPath   String
  durationSec Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

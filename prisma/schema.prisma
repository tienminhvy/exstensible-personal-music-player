// Prisma schema for the personal music player library.
// One Track row per youtubeId: audio always; video optional.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Track {
  id          String   @id @default(cuid())
  title       String
  // Unique so re-importing a known clip updates its row instead of
  // duplicating it.
  youtubeId   String   @unique
  // Stored RELATIVE to the media dir (<youtubeId>.mp3). Absolute paths
  // couple the DB to one container's filesystem layout and once cost
  // the whole library; keep this relative.
  mediaPath   String
  // Optional video file, stored RELATIVE to the media dir for the same
  // reason as mediaPath (<youtubeId>.<ext>); set only when the user
  // imports a video resolution.
  videoPath   String?
  // Search-result metadata captured at import time; nullable so rows
  // imported before this column existed stay valid.
  channel     String?
  thumbnailUrl String?
  durationSec Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
